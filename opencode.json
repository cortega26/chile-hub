{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--agent-interface",
        "tools",
        "--add-mode",
        "no-memories",
        "--open-web-dashboard",
        "false"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
